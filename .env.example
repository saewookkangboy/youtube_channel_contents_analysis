# GEMINI_API_KEY — Gemini API (Vite define로 클라이언트에 주입됨)
# Vercel: Project → Settings → Environment Variables
#   Production / Preview / Development 각각에 넣을 수 있음.
#   PR 프리뷰에는 운영과 다른 키를 쓰면 쿼터·노출 리스크를 줄일 수 있음.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY — GEMINI_API_KEY가 없을 때만 메인 리포트에 GPT-5.4 nano(기본) 사용; 둘 다 있으면 후단 검증 등 보조
# OPENAI_REPORT_MODEL=gpt-5.4-nano
# OPENAI_VERIFY_MODEL=gpt-4o-mini  — 심층 리포트 후단 병렬 팩트 검증(기본 gpt-4o-mini)
OPENAI_API_KEY=

# GEMINI_VERIFY_MODEL=gemini-3-flash-preview  — 후단 검증 전용(선택, 미설정 시 동일 기본값)

# APP_URL — 호스트 URL(선택, 자기 참조·콜백 등)
APP_URL="MY_APP_URL"

# VITE_YOUTUBE_API_KEY — YouTube Data API (선택, 팩트 수집·팩트 전용 모드)
# Vercel에서도 Preview 전용 제한 키(HTTP 리퍼러 등)를 쓰는 것을 권장.
VITE_YOUTUBE_API_KEY=

# 로컬 전용: 분석 프롬프트에 형식 보강 접미사 추가 (1=켜기, 토큰 소량 추가; 최종 리포트에 안내 문구가 노출되지 않도록 작성됨)
# 프로덕션 빌드에는 동적 청크가 포함되지 않음.
# VITE_DEV_AGENT_ORCHESTRATION=1

# Playwright E2E: 프로덕션 미리보기 빌드에서 ?reportPreview= 고정 마크다운을 켜려면 1 (기본 비활성)
# VITE_E2E_REPORT_PREVIEW=1
